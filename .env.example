NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# サイトURL
NEXT_PUBLIC_SITE_URL=https://cycle-z.com

# GA4 Data API / Search Console API（月次レポート自動取得用）
