# Google Ads コンバージョンタグ
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=AW-XXXXXXXXX

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Meta Pixel（Facebook広告配信時に設定）
